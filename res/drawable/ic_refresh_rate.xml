<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      Phone outline representing the device display.
      Rounded corners provide a consistent appearance at small sizes.
    -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:pathData="M9,2.75 H15 a2,2 0 0 1 2,2 V19.25 a2,2 0 0 1 -2,2 H9 a2,2 0 0 1 -2,-2 V4.75 a2,2 0 0 1 2,-2 Z" />

    <!--
      Refresh symbol indicating refresh rate control.
      The group scales and centers the arrows inside the phone outline.
    -->
    <group
        android:scaleX="0.45"
        android:scaleY="0.45"
        android:translateX="6.6"
        android:translateY="6.6">

        <!-- Circular arrows representing refresh rate switching. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,4V1L8,5l4,4V6c3.31,0 6,2.69 6,6c0,1.01 -0.25,1.97 -0.7,2.8l1.46,1.46C19.54,15.03 20,13.57 20,12C20,7.58 16.42,4 12,4zM12,18c-3.31,0 -6,-2.69 -6,-6c0,-1.01 0.25,-1.97 0.7,-2.8L5.24,7.74C4.46,8.97 4,10.43 4,12c0,4.42 3.58,8 8,8v3l4,-4l-4,-4V18z" />
    </group>
</vector>
